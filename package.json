{
  "name": "stockemoise-backend",
  "description": "backend of the stockemoise website",
  "main": "server.js",
  "scripts": {
    "start": "screen -d -m -S stock node src/server.js",
    "stop": "screen -Xs stock quit",
    "prod" : "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node src/scripts/js/test.js",
    "genDoc": "node ./src/scripts/swagger/swagger_jsdoc.js"
  },
  "oldScripts": {
    "build": "npm install && npm run init",
    "init": "npm run initDB && npm run initUploads",
    "initUploads": "node ./src/scripts/js/initUploads.js",
    "initDB": "node ./src/scripts/js/initDB.js",
    "initPG": "docker run --name stockemoiseDB -e POSTGRES_PASSWORD=1234 -p 5433:5432 -d postgres"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBLNgithub/stockemoise-backend.git"
  },
  "keywords": [],
  "author": "JBLN",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/JBLNgithub/stockemoise-backend/issues"
  },
  "homepage": "https://github.com/JBLNgithub/stockemoise-backend#readme",
  "type": "module",
  "dependencies": {
    "@vinejs/vine": "^3.0.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "swagger-jsdoc": "^6.2.8"
  }
}
