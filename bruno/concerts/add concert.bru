meta {
  name: add concert
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/api/concerts
  body: json
  auth: inherit
}

body:json {
  {
    "title": "new concert",
    "content": "description of the new concert",
    "cover": null,
    "datetimeEvent": "2025-12-25T05:05",
    "location": 2
  }
}

assert {
  res.status: eq 200
  res.body: isArray
}

settings {
  encodeUrl: true
  timeout: 0
}
